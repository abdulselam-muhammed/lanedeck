{
  "name": "selam-deck",
  "version": "0.1.0",
  "private": true,
  "description": "A local control room for working with AI coding agents: CI runners, machine load, Claude Code agents, GitHub PRs and a per-project work map.",
  "license": "MIT",
  "author": "Abdulselam Muhammed",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulselam-muhammed/selam-deck"
  },
  "homepage": "https://github.com/abdulselam-muhammed/selam-deck#readme",
  "bugs": {
    "url": "https://github.com/abdulselam-muhammed/selam-deck/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dashboard",
    "ai-agents",
    "claude-code",
    "ci",
    "work-map",
    "local-first"
  ],
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "next build",
    "start": "node server/index.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:protocol": "node scripts/check-protocol.mjs",
    "check": "npm run check:i18n && npm run check:protocol"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.9",
    "apexcharts": "^4.3.0",
    "echarts": "6.1.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-apexcharts": "^1.7.0",
    "react-dom": "19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
