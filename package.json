{
  "name": "lanedeck",
  "version": "0.2.1",
  "description": "A local control room for working with AI coding agents: CI runners, machine load, Claude Code agents, GitHub PRs and a per-project work map.",
  "license": "MIT",
  "author": "Abdulselam Muhammed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulselam-muhammed/lanedeck.git"
  },
  "homepage": "https://github.com/abdulselam-muhammed/lanedeck#readme",
  "bugs": {
    "url": "https://github.com/abdulselam-muhammed/lanedeck/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dashboard",
    "ai-agents",
    "claude-code",
    "ci",
    "work-map",
    "local-first"
  ],
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "next build",
    "start": "node server/index.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:protocol": "node scripts/check-protocol.mjs",
    "check": "npm run check:i18n && npm run check:protocol",
    "prepublishOnly": "npm run build && node scripts/scrub-build.mjs"
  },
  "dependencies": {
    "apexcharts": "^4.3.0",
    "echarts": "6.1.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-apexcharts": "^1.7.0",
    "react-dom": "19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "bin": {
    "lanedeck": "bin/lanedeck.mjs"
  },
  "files": [
    "bin",
    "server",
    "!server/ci/machines.json",
    "server.mjs",
    ".next",
    "!.next/cache",
    "!.next/trace",
    "!.next/types",
    "!.next/diagnostics",
    "!.next/**/*.map",
    "public",
    "plugin",
    "templates",
    "next.config.mjs",
    "config.example.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
